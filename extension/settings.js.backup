// Settings page JavaScript

const aiProviderSelect = document.getElementById('aiProvider');
const geminiSettings = document.getElementById('geminiSettings');
const openaiSettings = document.getElementById('openaiSettings');
const apiKeyInput = document.getElementById('apiKey');
const modelSelect = document.getElementById('model');
const openaiUrlInput = document.getElementById('openaiUrl');
const openaiTokenInput = document.getElementById('openaiToken');
const openaiModelSelect = document.getElementById('openaiModel');
const githubRepoInput = document.getElementById('githubRepo');
const githubBranchInput = document.getElementById('githubBranch');
const saveBtn = document.getElementById('saveBtn');
const statusMessage = document.getElementById('statusMessage');

// Load saved settings
document.addEventListener('DOMContentLoaded', loadSettings);

saveBtn.addEventListener('click', saveSettings);

// Toggle provider settings visibility
aiProviderSelect.addEventListener('change', () => {
  const provider = aiProviderSelect.value;
  if (provider === 'openai') {
    geminiSettings.style.display = 'none';
    openaiSettings.style.display = 'block';
  } else {
    geminiSettings.style.display = 'block';
    openaiSettings.style.display = 'none';
  }
});

function loadSettings() {
  chrome.storage.sync.get([
    'aiProvider',
    'geminiApiKey', 
    'geminiModel', 
    'openaiUrl',
    'openaiToken',
    'openaiModel',
    'githubRepo', 
    'githubBranch'
  ], (result) => {
    // Load provider selection
    if (result.aiProvider) {
      aiProviderSelect.value = result.aiProvider;
      // Trigger visibility change
      if (result.aiProvider === 'openai') {
        geminiSettings.style.display = 'none';
        openaiSettings.style.display = 'block';
      }
    }
    
    // Load Gemini settings
    if (result.geminiApiKey) {
      apiKeyInput.value = result.geminiApiKey;
    }
    if (result.geminiModel) {
      modelSelect.value = result.geminiModel;
    }
    
    // Load OpenAI settings
    if (result.openaiUrl) {
      openaiUrlInput.value = result.openaiUrl;
    }
    if (result.openaiToken) {
      openaiTokenInput.value = result.openaiToken;
    }
    if (result.openaiModel) {
      openaiModelSelect.value = result.openaiModel;
    }
    
    // Load GitHub settings
    if (result.githubRepo) {
      githubRepoInput.value = result.githubRepo;
    }
    if (result.githubBranch) {
      githubBranchInput.value = result.githubBranch;
    }
  });
}

function saveSettings() {
  const provider = aiProviderSelect.value;
  const githubRepo = githubRepoInput.value.trim();
  const githubBranch = githubBranchInput.value.trim() || 'main';

  // Validate based on provider
  if (provider === 'gemini') {
    const apiKey = apiKeyInput.value.trim();
    const model = modelSelect.value;
    
    if (!apiKey) {
      showStatus('Please enter a Gemini API key', 'error');
      return;
    }

    // Basic validation for Google API key format
    if (!apiKey.startsWith('AIza')) {
      showStatus('Invalid API key format. Google AI Studio keys start with "AIza"', 'error');
      return;
    }

    // Validate GitHub repo URL format if provided
    if (githubRepo && !isValidGitHubUrl(githubRepo)) {
      showStatus('Invalid GitHub URL. Use format: https://github.com/owner/repo', 'error');
      return;
    }

    // Save Gemini settings
    chrome.storage.sync.set({
      aiProvider: 'gemini',
      geminiApiKey: apiKey,
      geminiModel: model,
      githubRepo: githubRepo,
      githubBranch: githubBranch
    }, () => {
      showStatus('✅ Gemini settings saved successfully!', 'success');
      testGeminiApiKey(apiKey, model);
    });
    
  } else if (provider === 'openai') {
    const openaiUrl = openaiUrlInput.value.trim();
    const openaiToken = openaiTokenInput.value.trim();
    const openaiModel = openaiModelSelect.value;
    GeminiApiKey(apiKey, model) {
  try {
    const response = await fetch(
      `https://generativelanguage.googleapis.com/v1beta/models/${model}?key=${apiKey}`
    );

    if (response.ok) {
      showStatus('✅ Settings saved and Gemini API key validated!', 'success');
    } else {
      const error = await response.json();
      showStatus(`⚠️ Settings saved, but API key validation failed: ${error.error?.message || 'Unknown error'}`, 'error');
    }
  } catch (error) {
    showStatus('⚠️ Settings saved, but could not validate API key (check internet connection)', 'error');
  }
}

async function testOpenAIConnection(url, token, model) {
  try {
    // Test with a simple request
    const response = await fetch(`${url}/models`, {
      method: 'GET',
      headers: {
        'Authorization': `Bearer ${token}`
      }
    });

    if (response.ok) {
      showStatus('✅ Settings saved and OpenAI connection validated!', 'success');
    } else {
      // Try chat completions endpoint as fallback
      const chatResponse = await fetch(`${url}/chat/completions`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${token}`
        },
        body: JSON.stringify({
          model: model,
          messages: [{ role: 'user', content: 'test' }],
          max_tokens: 5
        })
      });
      
      if (chatResponse.ok || chatResponse.status === 400) {
        // 400 is OK - means endpoint exists and auth worked
        showStatus('✅ Settings saved and OpenAI endpoint accessible!', 'success');
      } else {
        showStatus(`⚠️ Settings saved, but connection test failed (${chatResponse.status}). Check your URL and token.`, 'error');
      }
    }
  } catch (error) {
    showStatus('⚠️ Settings saved, but could not validate connection (check URL and network
    } catch {
      showStatus('Invalid API URL format', 'error');
      return;
    }

    // Validate GitHub repo URL format if provided
    if (githubRepo && !isValidGitHubUrl(githubRepo)) {
      showStatus('Invalid GitHub URL. Use format: https://github.com/owner/repo', 'error');
      return;
    }

    // Save OpenAI settings
    chrome.storage.sync.set({
      aiProvider: 'openai',
      openaiUrl: openaiUrl,
      openaiToken: openaiToken,
      openaiModel: openaiModel,
      githubRepo: githubRepo,
      githubBranch: githubBranch
    }, () => {
      showStatus('✅ OpenAI settings saved successfully!', 'success');
      testOpenAIConnection(openaiUrl, openaiToken, openaiModel);
    });
  }
}

function isValidGitHubUrl(url) {
  // Validates GitHub URL format
  const githubPattern = /^https:\/\/github\.com\/[\w-]+\/[\w.-]+\/?$/;
  return githubPattern.test(url);
}

async function testApiKey(apiKey, model) {
  try {
    const response = await fetch(
      `https://generativelanguage.googleapis.com/v1beta/models/${model}?key=${apiKey}`
    );

    if (response.ok) {
      showStatus('✅ Settings saved and API key validated!', 'success');
    } else {
      const error = await response.json();
      showStatus(`⚠️ Settings saved, but API key validation failed: ${error.error?.message || 'Unknown error'}`, 'error');
    }
  } catch (error) {
    showStatus('⚠️ Settings saved, but could not validate API key (check internet connection)', 'error');
  }
}

function showStatus(message, type) {
  statusMessage.textContent = message;
  statusMessage.className = `status-message ${type}`;
  statusMessage.style.display = 'block';

  if (type === 'success') {
    setTimeout(() => {
      statusMessage.style.display = 'none';
    }, 3000);
  }
}
