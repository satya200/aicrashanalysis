// AI Service - Multi-Provider API Integration (Gemini & OpenAI)
// This module handles all AI-related operations

class AIService {
  constructor() {
    this.provider = 'gemini'; // 'gemini' or 'openai'
    this.apiKey = null;
    this.model = 'gemini-2.5-flash';
    this.baseUrl = 'https://generativelanguage.googleapis.com/v1beta/models';
    // OpenAI specific
    this.openaiUrl = null;
    this.openaiToken = null;
    this.openaiModel = null;
  }

  // Initialize with API key from storage
  async initialize() {
    return new Promise((resolve, reject) => {
      chrome.storage.sync.get([
        'aiProvider',
        'geminiApiKey', 
        'geminiModel',
        'openaiUrl',
        'openaiToken',
        'openaiModel'
      ], (result) => {
        this.provider = result.aiProvider || 'gemini';
        
        if (this.provider === 'openai') {
          // Initialize OpenAI settings
          if (result.openaiToken && result.openaiUrl) {
            this.openaiToken = result.openaiToken;
            this.openaiUrl = result.openaiUrl;
            this.openaiModel = result.openaiModel || 'gpt-5-2';
            resolve(true);
          } else {
            reject(new Error('OpenAI credentials not configured'));
          }
        } else {
          // Initialize Gemini settings (default)
          if (result.geminiApiKey) {
            this.apiKey = result.geminiApiKey;
            this.model = result.geminiModel || 'gemini-2.5-flash';
            resolve(true);
          } else {
            reject(new Error('Gemini API key not configured'));
          }
        }
      });
    });
  }

  // Check if API key is configured
  async isConfigured() {
    try {
      await this.initialize();
      return true;
    } catch {
      return false;
    }
  }

  // Generate crash analysis prompt
  generateAnalysisPrompt(stackTrace, parsedFrames, repoContextInfo = null) {
    // repoContextInfo: { hasCode: boolean, formatted: string }
    const hasRepoContext = repoContextInfo && repoContextInfo.formatted;
    const hasActualCode = repoContextInfo && repoContextInfo.hasCode;
    const repoFormatted = hasRepoContext ? repoContextInfo.formatted : '';
    
    console.log('🤖 AI Prompt Config:', {
      hasRepoContext: !!hasRepoContext,
      hasActualCode: !!hasActualCode,
      willShowSection4: !!hasRepoContext,  // Fixed: Show section 4 whenever repo is configured
      repoInfoLength: repoFormatted.length
    });

    return `You are a senior Linux crash analysis engineer.

Analyze the crash stack trace and provide actionable debugging guidance.

STACK TRACE
${stackTrace}

PARSED STACK
- Total Frames: ${parsedFrames.length}
- Top Frame: ${parsedFrames[0]?.function || 'Unknown'} at ${parsedFrames[0]?.file || 'Unknown'}:${parsedFrames[0]?.line || '?'}

${repoFormatted}

Do not invent files, functions, or repository structure.
State assumptions if information is missing.

Provide the following sections:

### ROOT CAUSE
- Suspicious frame
- Explanation of the likely failure
- Evidence from the stack trace
- Confidence: High / Medium / Low
- Alternative hypotheses (max 2)

### CRASH PATTERN

| Pattern | Likelihood | Reason |
|--------|-----------|-------|
| Null pointer dereference | | |
| Memory corruption | | |
| Use-after-free | | |
| Race condition | | |
| Logic/state bug | | |

### INVESTIGATION STEPS
Provide 3-5 concrete debugging steps including commands or tools.

${hasRepoContext ? `
### REPOSITORY DEBUGGING
Suggest specific files, functions, or areas in the repository to inspect.
${hasActualCode ? 'Reference the provided source code when relevant.' : ''}
` : ''}
`;
  }

  // Generate follow-up prompt for interactive chat
  generateFollowUpPrompt(originalStackTrace, previousAnalysis, userQuestion) {
    return `You are continuing a crash analysis conversation.

**ORIGINAL STACK TRACE:**
\`\`\`
${originalStackTrace}
\`\`\`

**PREVIOUS ANALYSIS:**
${previousAnalysis}

**USER'S FOLLOW-UP QUESTION:**
${userQuestion}

**YOUR TASK:**
Answer the user's question with specific, technical details related to this crash. Be concise but thorough.`;
  }

  // Call AI API for crash analysis (routes to appropriate provider)
  async analyzeCrash(stackTrace, parsedFrames, repoContextInfo = null) {
    await this.initialize();
    
    if (this.provider === 'openai') {
      return await this.analyzeWithOpenAI(stackTrace, parsedFrames, repoContextInfo);
    } else {
      return await this.analyzeWithGemini(stackTrace, parsedFrames, repoContextInfo);
    }
  }

  // Call Gemini API for crash analysis
  async analyzeWithGemini(stackTrace, parsedFrames, repoContextInfo = null) {
    const prompt = this.generateAnalysisPrompt(stackTrace, parsedFrames, repoContextInfo);
    
    const requestBody = {
      contents: [{
        parts: [{
          text: prompt
        }]
      }],
      generationConfig: {
        temperature: 0.7,
        topK: 40,
        topP: 0.95,
        maxOutputTokens: 4096,
      },
      safetySettings: [
        {
          category: "HARM_CATEGORY_HARASSMENT",
          threshold: "BLOCK_NONE"
        },
        {
          category: "HARM_CATEGORY_HATE_SPEECH",
          threshold: "BLOCK_NONE"
        },
        {
          category: "HARM_CATEGORY_SEXUALLY_EXPLICIT",
          threshold: "BLOCK_NONE"
        },
        {
          category: "HARM_CATEGORY_DANGEROUS_CONTENT",
          threshold: "BLOCK_NONE"
        }
      ]
    };

    try {
      const response = await fetch(
        `${this.baseUrl}/${this.model}:generateContent?key=${this.apiKey}`,
        {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(requestBody)
        }
      );

      if (!response.ok) {
        const errorData = await response.json();
        throw new Error(errorData.error?.message || `Gemini API request failed: ${response.status}`);
      }

      const data = await response.json();
      
      if (data.candidates && data.candidates[0]?.content?.parts[0]?.text) {
        const analysisText = data.candidates[0].content.parts[0].text;
        console.log('✅ Gemini Response received:', {
          length: analysisText.length,
          sections: (analysisText.match(/\*\*[A-Z][A-Z\s]+\*\*/g) || []).length
        });
        return {
          success: true,
          analysis: analysisText,
          model: this.model,
          provider: 'gemini'
        };
      } else {
        throw new Error('Unexpected Gemini API response format');
      } (routes to appropriate provider)
  async askFollowUp(originalStackTrace, previousAnalysis, userQuestion) {
    await this.initialize();
    
    if (this.provider === 'openai') {
      return await this.askFollowUpOpenAI(originalStackTrace, previousAnalysis, userQuestion);
    } else {
      return await this.askFollowUpGemini(originalStackTrace, previousAnalysis, userQuestion);
    }
  }

  // Gemini follow-up question
  async askFollowUpGemini(originalStackTrace, previousAnalysis, userQuestion) {
    const prompt = this.generateFollowUpPrompt(originalStackTrace, previousAnalysis, userQuestion);
    
    const requestBody = {
      contents: [{
        parts: [{
          text: prompt
        }]
      }],
      generationConfig: {
        temperature: 0.8,
        maxOutputTokens: 1024,
      }
    };

    try {
      const response = await fetch(
        `${this.baseUrl}/${this.model}:generateContent?key=${this.apiKey}`,
        {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(requestBody)
        }
      );

      if (!response.ok) {
        const errorData = await response.json();
        throw new Error(errorData.error?.message || `Gemini API request failed: ${response.status}`);
      }

      const data = await response.json();
      
      if (data.candidates && data.candidates[0]?.content?.parts[0]?.text) {
        return {
          success: true,
          answer: data.candidates[0].content.parts[0].text,
          model: this.model,
          provider: 'gemini'
        };
      } else {
        throw new Error('Unexpected API response format');
      }
    } catch (error) {
      console.error('Gemini Service Error:', error);
      throw error;
    }
  }

  // OpenAI follow-up question
  async askFollowUpOpenAI(originalStackTrace, previousAnalysis, userQuestion) {
    const prompt = this.generateFollowUpPrompt(originalStackTrace, previousAnalysis, userQuestion);
    
    const requestBody = {
      model: this.openaiModel,
      messages: [
        {
          role: 'system',
          content: 'You are a senior Linux crash analysis engineer. Answer follow-up questions about crash analysis concisely but thoroughly.'
        },
        {
          role: 'user',
          content: prompt
        }
      ],
      temperature: 0.8,
      max_tokens: 1024
    };

    try {
      const response = await fetch(`${this.openaiUrl}/chat/completions`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${this.openaiToken}`
        },
        body: JSON.stringify(requestBody)
      });

      if (!response.ok) {
        const errorData = await response.json();
        throw new Error(errorData.error?.message || `OpenAI API request failed: ${response.status}`);
      }

      const data = await response.json();
      
      if (data.choices && data.choices[0]?.message?.content) {
        return {
          success: true,
          answer: data.choices[0].message.content,
          model: this.openaiModel,
          provider: 'openai'
        };
      } else {
        throw new Error('Unexpected API response format');
      }
    } catch (error) {
      console.error('Open { message: errorText };
        }
        throw new Error(errorData.error?.message || errorData.message || `OpenAI API request failed: ${response.status}`);
      }

      const data = await response.json();
      
      if (data.choices && data.choices[0]?.message?.content) {
        const analysisText = data.choices[0].message.content;
        console.log('✅ OpenAI Response received:', {
          length: analysisText.length,
          model: data.model || this.openaiModel,
          sections: (analysisText.match(/\*\*[A-Z][A-Z\s]+\*\*/g) || []).length
        });
        return {
          success: true,
          analysis: analysisText,
          model: this.openaiModel,
          provider: 'openai'
        };
      } else {
        throw new Error('Unexpected OpenAI API response format');
      }
    } catch (error) {
      console.error('OpenAI Service Error:', error);
      throw error;
    }
  }

  // Interactive follow-up question
  async askFollowUp(originalStackTrace, previousAnalysis, userQuestion) {
    if (!this.apiKey) {
      await this.initialize();
    }

    const prompt = this.generateFollowUpPrompt(originalStackTrace, previousAnalysis, userQuestion);
    
    const requestBody = {
      contents: [{
        parts: [{
          text: prompt
        }]
      }],
      generationConfig: {
        temperature: 0.8,
        maxOutputTokens: 1024,
      }
    };

    try {
      const response = await fetch(
        `${this.baseUrl}/${this.model}:generateContent?key=${this.apiKey}`,
        {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(requestBody)
        }
      );

      if (!response.ok) {
        const errorData = await response.json();
        throw new Error(errorData.error?.message || `API request failed: ${response.status}`);
      }

      const data = await response.json();
      
      if (data.candidates && data.candidates[0]?.content?.parts[0]?.text) {
        return {
          success: true,
          answer: data.candidates[0].content.parts[0].text,
          model: this.model
        };
      } else {
        throw new Error('Unexpected API response format');
      }
    } catch (error) {
      console.error('AI Service Error:', error);
      throw error;
    }
  }
}

// Export for use in popup.js
window.AIService = AIService;
